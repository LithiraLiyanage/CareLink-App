rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasValidRole(data) {
      return !data.keys().hasAny(['role'])
        || data.role == null
        || data.role in [
          'Older Adult',
          'Student Companion',
          'Family Caregiver'
        ];
    }

    function hasClientWritableVerificationStatus(data) {
      return !data.keys().hasAny(['verificationStatus'])
        || data.verificationStatus in [
          'notSubmitted',
          'pending',
          'notRequired'
        ];
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && hasValidRole(request.resource.data)
        && hasClientWritableVerificationStatus(request.resource.data);
      allow update: if isOwner(userId)
        && hasValidRole(request.resource.data)
        && hasClientWritableVerificationStatus(request.resource.data)
        && (
          !resource.data.keys().hasAny(['createdAt'])
          || request.resource.data.createdAt == resource.data.createdAt
        );
    }

    match /consents/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == userId;
      allow delete: if isOwner(userId);
    }

    match /student_verifications/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && get(/databases/$(database)/documents/users/$(userId)).data.role
          == 'Student Companion'
        && request.resource.data.userId == userId
        && request.resource.data.status == 'pending';
    }
  }
}
