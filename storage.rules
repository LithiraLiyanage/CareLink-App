rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Matches AddMemoryScreen: memories/<authenticated-uid>/<unique-file>.
    // Does not grant any access to student verification documents.
    match /memories/{userId}/{fileName} {
      allow read: if request.auth != null
        && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size > 0
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');

      // Each upload has a new unique name; prevent overwriting other files.
      allow update: if false;

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}
