rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isStudentCompanion(userId) {
      return isOwner(userId)
        && firestore.get(
          /databases/(default)/documents/users/$(userId)
        ).data.role == 'Student Companion';
    }

    function isValidVerificationDocument() {
      return request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType is string
        && request.resource.contentType.matches(
          '^(image/(jpeg|png)|application/pdf)$'
        );
    }

    // Memory Lane images: memories/<authenticated-uid>/<unique-file>.
    match /memories/{userId}/{fileName} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.size > 0
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType is string
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');

      // Uploads use unique file names; don't permit overwrites.
      allow update: if false;

      allow delete: if isOwner(userId);
    }

    // Student verification documents: student_verifications/<uid>/<file>.
    match /student_verifications/{userId}/{fileName} {
      allow read, delete: if isOwner(userId);

      allow create: if isOwner(userId)
        && isStudentCompanion(userId)
        && isValidVerificationDocument();

      allow update: if false;
    }
  }
}
