+            && request.resource.data.scheduledAt > request.time
+          )
+        )
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'scheduledAt', 'status', 'reflection', 'updatedAt', 'startedAt', 'completedAt'
         ])
